  _start_bridge_bg "$argv_json" BG_OUT
  _wait_for_role_state verifier "$action" READY >/dev/null

  kill -TERM "$BG_PID" 2>/dev/null || true
  _wait_for_pid_exit "$BG_PID"
  wait "$BG_PID" 2>/dev/null; BG_PID=""

