      process.exit(0);
    });
  ' "$BRIDGE"
  [ "$status" -eq 0 ]
}

@test "C2-GAP-07 FAIL: initialize() with an already-past backendDeadlineMs writes ZERO bytes and refuses immediately, never starts the call (item 11 deadline arithmetic)" {
  run node -e '
