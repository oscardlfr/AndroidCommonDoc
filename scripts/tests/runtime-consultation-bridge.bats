  node -e '
    const fs = require("fs");
    const o = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    o.created_at = o.expiry;
    o.expiry = new Date(Date.parse(o.expiry) - 60000).toISOString().replace(/\.\d{3}Z$/, "Z");
    fs.writeFileSync(process.argv[1], JSON.stringify(o));
  ' "$claim_path"
