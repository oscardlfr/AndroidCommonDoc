    });
    const initP = conn.initialize();
    setImmediate(() => {
      const initReq = sent.find((f) => f.method === "initialize");
      fromChild.write(JSON.stringify({ id: initReq.id, result: { userAgent: "x", codexHome: "/h", platformFamily: "unix", platformOs: "macos" } }) + "\n");
    });
    initP.then((initRes) => {
